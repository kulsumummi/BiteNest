# BiteNest Environment Variables Template
# Copy this file to .env for local development

# Django Settings
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=bitenest-secret-key-change-in-production
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Database Configuration (Optional: SQLite used by default if empty)
# For PostgreSQL in Production (Render / Heroku / AWS):
# DATABASE_URL=postgres://username:password@hostname:5432/dbname
